diff -ruN a/config/runtime.exs b/config/runtime.exs
--- a/config/runtime.exs	2026-10-24 21:26:21.733167281 -0400
+++ b/config/runtime.exs	2026-10-24 21:26:21.751571487 -0400
@@ -16,13 +16,20 @@
     pool_size: String.to_integer(System.get_env("DB_POOL_SIZE") || "#{min(4 * cores, 90)}"),
     # At saturation, let a query wait up to 200 ms for a connection (DBConnection's default is 50 ms) before the
     # pool starts shedding: latency has headroom under the 500 ms p95 limit, while every shed query is a 500.
-    queue_target: 200,
+    # EXPERIMENT SWITCHES (tuning/patches/experiment-switches.patch; scratch copies only, never committed)
+    queue_target: String.to_integer(System.get_env("XQ_TARGET", "200")),
+    pool_count: String.to_integer(System.get_env("XPOOL_COUNT", "1")),
+    queue_interval: String.to_integer(System.get_env("XQ_INTERVAL", "2000")),
+    log: if(System.get_env("XREPO_LOG") == "false", do: false, else: :debug),
+    types: if(System.get_env("XPG_REF") == "false", do: Postgrex.DefaultTypes, else: Conduit.PostgrexTypes),
     # Each connection reuses one generic plan per prepared statement. Postgres's default picks it after five runs
     # for every statement but the global and tag lists' ids queries, whose LIMIT parameter makes the generic plan's
     # cost estimate look worse than a custom plan for LIMIT 10, so it re-planned them on every call (0.09 and 0.15 ms,
     # ~7% of Postgres's statement time); their generic plans are the same backward index scans. Session-level, so
     # within the box's fixed server config.
-    parameters: [plan_cache_mode: "force_generic_plan"]
+    parameters: [plan_cache_mode: System.get_env("XPG_PLAN", "force_generic_plan")]
+
+  if System.get_env("XPHX_LOG") == "false", do: config(:phoenix, :logger, false)
 
   config :conduit, ConduitWeb.Endpoint,
     server: true,
@@ -31,19 +38,22 @@
       port: String.to_integer(System.get_env("PORT", "3000")),
       # Responses go out uncompressed: gzip is optional in SPEC.md and costs CPU on every response, which the box,
       # shared with Postgres, is shorter of than bandwidth.
-      http_options: [compress: false],
+      http_options: [
+        compress: false,
+        log_exceptions_with_status_codes: if(System.get_env("XLOG_EXC") == "false", do: [], else: 500..599)
+      ],
       # Collect each connection's garbage after every request (Bandit's default is every 5th), so a user who is
       # thinking between pages doesn't hold on to the heap their last request built.
-      http_1_options: [gc_every_n_keepalive_requests: 1],
+      http_1_options: [gc_every_n_keepalive_requests: String.to_integer(System.get_env("XGC_EVERY", "1"))],
       thousand_island_options: [
         # Clients hold one keep-alive connection each and think for up to 70 s between pages; don't close them first.
         read_timeout: 75_000,
         # Every user connects directly, so allow bursts of new connections (the box's somaxconn is 65535).
-        transport_options: [backlog: 8192],
+        transport_options: [backlog: 8192] ++ if(System.get_env("XTI_SOCKET") == "true", do: [inet_backend: :socket], else: []),
         # Start each connection process with a 4,181-word (33 KB) heap. The GC after every request shrinks the heap
         # back to this minimum, and a request needs about this much, so it no longer re-grows the heap through a
         # series of minor collections on every request. Costs ~35 KB per connection (~1 GB at 27,000 users).
-        genserver_options: [spawn_opt: [min_heap_size: 4181]]
+        genserver_options: [spawn_opt: [min_heap_size: String.to_integer(System.get_env("XMIN_HEAP", "4181"))]]
       ]
     ]
 
diff -ruN a/lib/conduit/accounts/token.ex b/lib/conduit/accounts/token.ex
--- a/lib/conduit/accounts/token.ex	2026-10-24 21:26:21.734274142 -0400
+++ b/lib/conduit/accounts/token.ex	2026-10-24 21:26:21.738877151 -0400
@@ -35,7 +35,13 @@
   """
   @spec fetch_user_id(String.t()) :: {:ok, pos_integer()} | :error
   def fetch_user_id(token) do
-    case verify_and_validate(token) do
+    claims =
+      case :persistent_term.get(__MODULE__, nil) do
+        nil -> verify_and_validate(token)
+        signer -> verify_and_validate(token, signer)
+      end
+
+    case claims do
       {:ok, %{"sub" => sub, "exp" => _exp}} -> {:ok, String.to_integer(sub)}
       _invalid -> :error
     end
diff -ruN a/lib/conduit/application.ex b/lib/conduit/application.ex
--- a/lib/conduit/application.ex	2026-10-24 21:26:21.735371453 -0400
+++ b/lib/conduit/application.ex	2026-10-24 21:26:21.738956743 -0400
@@ -4,6 +4,10 @@
 
   @impl true
   def start(_type, _args) do
+    # EXPERIMENT SWITCH XSIGNER=prebuilt: parse the HS256 key once instead of on every verify
+    if System.get_env("XSIGNER") == "prebuilt",
+      do: :persistent_term.put(Conduit.Accounts.Token, Joken.Signer.parse_config(:default_signer))
+
     children = [ConduitWeb.Telemetry, Conduit.Repo, ConduitWeb.Endpoint]
     Supervisor.start_link(children, strategy: :one_for_one, name: Conduit.Supervisor)
   end
